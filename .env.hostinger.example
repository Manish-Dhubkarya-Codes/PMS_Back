# ============================================================
# Hostinger / live API (api.cognicodeedutech.com) example env
# Copy values into the real server .env — do not commit secrets.
# ============================================================

NODE_ENV=production

# --- Cognicode / Blog PostgreSQL (Hostinger) ---
# Use the Hostinger PostgreSQL host from hPanel (not localhost unless DB is on same VPS)
PG_HOST=your-hostinger-postgres-host
PG_PORT=5432
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
PG_DATABASE=your_main_pms_db
PG_COGNICODE_DATABASE=Cognicode

# Hostinger remote PG almost always needs SSL:
PG_SSL=true

# --- Website admin (admindetails in Cognicode DB) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# After deploy, verify:
#   GET  https://api.cognicodeedutech.com/blog/health
#   POST https://api.cognicodeedutech.com/blog/admin/init-tables?adminId=1&email=...
# Or on the server:
#   node scripts/init-blog-tables.js
